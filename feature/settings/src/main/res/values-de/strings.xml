    <string name="settings_background_updates_section">Hintergrund-Updates</string>
    <string name="settings_background_updates_explain">Kiln kann Quellen alle 12 Stunden im Hintergrund synchronisieren und benachrichtigen, wenn passende Updates vorliegen. Auto-Install ist optional und nur für signaturgleiche APKs.</string>
