    <string name="settings_background_updates_section">Hintergrund-Updates</string>
    <string name="settings_background_updates_explain">Kiln kann Quellen im Hintergrund im gewählten Intervall synchronisieren und benachrichtigen, wenn passende Updates vorliegen. Auto-Install ist optional und nur für signaturgleiche APKs.</string>
    <string name="settings_background_enabled">Im Hintergrund nach Updates suchen</string>
    <string name="settings_unmetered_only">Nur WLAN / unmetered</string>
    <string name="settings_auto_install_matching">Signaturgleiche Updates automatisch installieren</string>
    <string name="settings_auto_install_hint">Updates mit Signaturwarnung werden nie automatisch installiert. Major-Sprünge brauchen immer einen manuellen Tip.</string>
    <string name="settings_update_cooldown">Auto-Install-Wartezeit (Tage)</string>
    <string name="settings_update_cooldown_hint">So viele Tage warten, nachdem Kiln ein Update zuerst gesehen hat. 0 = aus.</string>
    <string name="settings_update_cooldown_value">%1$d Tage</string>
    <string name="settings_rollback_keep">Rollback-APKs pro App</string>
    <string name="settings_rollback_keep_hint">Nach jeder erfolgreichen Installation behält Kiln so viele ältere APKs für Downgrades. Ein niedrigerer Wert löscht Überschüsse sofort.</string>
    <string name="settings_rollback_keep_value">%1$d Versionen</string>
    <string name="settings_ignored_updates">Ignorierte Updates</string>
    <string name="settings_ignored_updates_explain">Apps, bei denen die Update-Prüfung ausgeschaltet ist. Erneut aktivieren, um sie wieder zu syncen.</string>
    <string name="settings_ignored_updates_empty">Keine Apps ignorieren Updates.</string>
