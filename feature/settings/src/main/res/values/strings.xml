    <string name="settings_automation_section">Automation</string>
    <string name="settings_automation_explain">Allow same-signer apps (or ADB) to send CHECK_UPDATES, INSTALL_UPDATE, INSTALL_FROM_URL, and CLEAN_CACHE broadcasts. Off by default. Results are broadcast under the AUTOMATION signature permission.</string>
    <string name="settings_automation_enabled">Enable Intent / Broadcast API</string>
    <string name="settings_maintenance_section">Maintenance</string>
    <string name="settings_maintenance_explain">Weekly cleanup on Wi‑Fi while charging: optional system cache trim (needs Shizuku), prune old download/rollback APKs and backup temps. Does not delete SAF backups you saved yourself. Off by default.</string>
