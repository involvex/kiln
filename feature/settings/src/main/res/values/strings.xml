    <string name="settings_auto_install_hint">WARNUNG / signature-mismatch updates are never installed automatically. Major version bumps always need a manual tap.</string>
    <string name="settings_update_cooldown">Auto-install cooldown (days)</string>
    <string name="settings_update_cooldown_hint">Wait this many days after Kiln first sees an update before auto-install. 0 = off.</string>
